shell-integration = zsh
font-family = JetBrains Mono
theme = TokyoNight

keybind = ctrl+s>h=new_split:left
keybind = ctrl+s>j=new_split:down
keybind = ctrl+s>k=new_split:up
keybind = ctrl+s>l=new_split:right
keybind = ctrl+w>h=goto_split:left
keybind = ctrl+w>j=goto_split:bottom
keybind = ctrl+w>k=goto_split:top
keybind = ctrl+w>l=goto_split:right
keybind = ctrl+w>n=new_window
keybind = ctrl+w>f=toggle_split_zoom

